{
  "name": "@majlis/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/websocket": "^11.3.6",
    "@majlis/shared": "workspace:*",
    "aws4fetch": "^1.0.20",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "jose": "^6.2.15",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7",
    "ws": "^8"
  }
}
