DATABASE_URL=postgres://majlis:majlis@localhost:5432/majlis
# Optional locally (single instance). Required in production when running >1 instance.
REDIS_URL=
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Comma-separated list of allowed web origins. Empty = allow all (dev only).
CORS_ORIGINS=
# Public web URL, used to build invite links.
WEB_URL=http://localhost:3000
# Public URL of this API. Used for file URLs when R2 isn't configured.
PUBLIC_API_URL=http://localhost:4000
# Cloudflare R2 (S3-compatible). Leave R2_ACCOUNT_ID empty to store files on local disk in dev.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=majlis-media
STORAGE_DIR=.uploads
# Whop payments (sandbox while testing). Leave WHOP_API_KEY empty to disable checkout.
WHOP_ENV=sandbox
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_WEBHOOK_SECRET=
# Earnings hold (refund window) and minimum payout, in minor units (10000 = 100.00 SAR).
PAYOUT_HOLD_DAYS=14
PAYOUT_MIN_MINOR=10000
# Comma-separated emails of Majlis staff who can open the owner Payouts page.
PLATFORM_ADMIN_EMAILS=
